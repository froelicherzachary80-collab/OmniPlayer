# ── OmniPlayer configuration (copy to .env) ──
# Admin login for the dashboard. If unset, a random password is generated and printed once.
OMNI_ADMIN_PASSWORD=
# 64 hex chars; encrypts stored Microsoft/Minecraft tokens. Generated into data/ if unset.
OMNI_SECRET_KEY=
# Address players use to reach this host (LAN IP, Tailscale name or domain). Shown on the Play page.
OMNI_PUBLIC_HOST=
OMNI_PORT=8080
OMNI_DATA_DIR=./data

# Microsoft sign-in for authenticated Minecraft accounts (Azure app, public client, device code flow).
# See docs/ACCOUNTS.md — note Mojang must approve new apps for Minecraft services access.
OMNI_MS_CLIENT_ID=

# Resource limits (see docs/HARDWARE.md)
OMNI_MAX_BOTS=16
OMNI_MAX_STREAMS=2
OMNI_STREAM_PRESET=medium      # low | medium | high
OMNI_BOT_THINK_TICKS=20        # how often idle bots re-plan (20 ticks = 1 s)
OMNI_BOT_VIEW_DISTANCE=6       # chunks each bot keeps in memory

# Optional local LLM for richer dialogue (Ollama-compatible). Never required.
OMNI_LLM_ENDPOINT=
OMNI_LLM_MODEL=llama3.2

# VoiceBox / MediaMTX locations (defaults work for a single host)
OMNI_VOICEBOX_URL=http://127.0.0.1:8095
OMNI_MEDIAMTX_MANAGED=true

# Private testing only: labelled "SIMULATED" chat participants. Never shown as real viewers.
OMNI_SIMULATED_CHAT=false
